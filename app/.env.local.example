# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored and must never be committed.
#
# Both values below are safe to expose in the browser — the anon key is a
# PUBLISHABLE key whose power is bounded entirely by Row Level Security
# policies on your tables. Find them in the Supabase dashboard under
# Project Settings -> API.
#
# NEVER put the `service_role` key in this file or anywhere under src/.
# That key bypasses RLS completely.

NEXT_PUBLIC_SUPABASE_URL=https://kvnmydvsffjvrsndnawd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Required for full account deletion (/api/account/delete).
# NO NEXT_PUBLIC_ PREFIX — that prefix ships a value to the browser, and this
# key bypasses Row Level Security completely. Anyone holding it can read or
# delete every user's data. Supabase dashboard -> Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=

# SERVER-ONLY. Required for Ask AI (/api/chat).
# NO NEXT_PUBLIC_ PREFIX. An API key shipped to the browser is a public API
# key — anyone can read it out of the JS bundle and spend it. This is exactly
# the bug the original prototype had (a client-side fetch straight to a model
# API) and the reason /api/chat exists as a server route at all.
#
# Currently Gemini 2.5 Flash on the free tier — a deliberate "no billing yet"
# choice while the app has no users. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Planned switch once usage justifies billing. Not read while the route is on
# Gemini; see the PROVIDER note at the top of src/app/api/chat/route.ts.
# ANTHROPIC_API_KEY=
